{
  "name": "dsh-quota-hub",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: aggregated coding-plan quota monitor (GLM / MiniMax / Kimi / DeepSeek) with per-provider detail panels, chat dock pills and a sidebar badge.",
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "quota",
    "coding-plan",
    "glm",
    "minimax",
    "kimi",
    "deepseek"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DarkDarkdDarkWine/dsh-quota-hub.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
